# API keys for the dynamic-fewshot pipeline. Copy to .env (gitignored).

# Inference (infer.py) — set the key for whichever backend you use.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Embeddings (build_corpus.py / dynamic regime) default to a local vLLM
# OpenAI-compatible endpoint and need no key. Set one only if you point
# --embed-url at a hosted provider.
# EMBED_API_KEY=
