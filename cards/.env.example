# API keys for the cards pipeline. Copy to .env (gitignored) before running.

# Inference (infer.py) — set the key for whichever backend you use.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Teacher RECoT generation (teacher.py) goes through LiteLLM and auto-
# routes by model id. Set the provider key matching your --model.
ANTHROPIC_API_KEY=

# Hugging Face Hub (ft/train.py, ft/quantize.py): model push + auth.
HF_TOKEN=
# Optional — overrides the default HF user for training/push targets.
# HF_USERNAME=
